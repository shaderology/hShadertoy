# Ignore everything by default
/*

!.gitignore

# Allow these top-level folders
!src/
!tests/
!houdini/
!.claude/

# Allow root README
!README.md
!CLAUDE.md
!pytest.ini
!requirements.txt

# Ignore Python cache dirs inside allowed folders
src/**/__pycache__/
tests/**/__pycache__/
houdini/**/__pycache__/

# Ignore Houdini backup files
houdini/**/backup/
     {
      "code": "void mainImage( out vec4 fragColor, in vec2 fragCoord )\n{\n    int iResolution_y_render\n        = number(iResolution.y, 0, 3.0, vec2(10, 10), fragCoord);\n    int iResolution_x_render\n        = number(iResolution.x, 0, 3.0, vec2(10, 52), fragCoord);\n        \n    int iTime_render \n        = number(iTime, 4, 3.0, vec2(10, 136), fragCoord);\n    int iTimeDelta_render \n        = number(iTimeDelta, 4, 3.0, vec2(10, 178), fragCoord);\n        \n    int iFrameRate_render\n        = number(iFrameRate, 4, 3.0, vec2(10, 262), fragCoord);\n    int iFrame_render \n        = number(float(iFrame), 0, 3.0, vec2(10, 304), fragCoord);\n        \n    int iMouse_w_render\n        = number(iMouse.w, 0, 3.0, vec2(10, 388), fragCoord);\n    int iMouse_z_render\n        = number(iMouse.z, 0, 3.0, vec2(10, 430), fragCoord);\n    int iMouse_y_render\n        = number(iMouse.y, 0, 3.0, vec2(10, 472), fragCoord);\n    int iMouse_x_render\n        = number(iMouse.x, 0, 3.0, vec2(10, 514), fragCoord);\n    \n    fragColor = vec4(\n        iResolution_y_render+\n        iResolution_x_render+\n        iTime_render+\n        iTimeDelta_render+\n        iFrame_render+\n        iFrameRate_render+\n        iMouse_w_render+\n        iMouse_z_render+\n        iMouse_y_render+\n        iMouse_x_render\n    );\n}",
